{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guides.example/contracts/model-event-1.0.schema.json",
  "title": "Coding agent model event",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "kind", "sequence", "payload"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "kind": {"enum": ["TEXT_DELTA", "ACTION_DELTA", "ACTION_COMPLETE", "USAGE", "COMPLETED", "ERROR"]},
    "sequence": {"type": "integer", "minimum": 0},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "TEXT_DELTA"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "maxLength": 1000000}}}}}
    },
    {
      "if": {"properties": {"kind": {"const": "ACTION_DELTA"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["action_id", "delta"], "properties": {"action_id": {"$ref": "#/$defs/identifier"}, "delta": {"type": "string", "maxLength": 1000000}}}}}
    },
    {
      "if": {"properties": {"kind": {"const": "ACTION_COMPLETE"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"$ref": "action.schema.json"}}}}}
    },
    {
      "if": {"properties": {"kind": {"const": "USAGE"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "cost_microunits"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "cost_microunits": {"type": "integer", "minimum": 0}}}}}
    },
    {
      "if": {"properties": {"kind": {"const": "COMPLETED"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "properties": {"finish_reason": {"type": "string", "minLength": 1, "maxLength": 128}}}}}
    },
    {
      "if": {"properties": {"kind": {"const": "ERROR"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"$ref": "#/$defs/identifier"}, "message": {"type": "string", "minLength": 1, "maxLength": 10000}, "retryable": {"type": "boolean"}}}}}
    }
  ],
  "$defs": {"identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
