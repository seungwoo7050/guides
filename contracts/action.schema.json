{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guides.example/contracts/agent-action-1.0.schema.json",
  "title": "Coding agent action",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "action_id", "kind", "arguments", "purpose"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "kind": {
      "enum": [
        "REPOSITORY_STATUS", "LIST_FILES", "READ_FILE", "SEARCH_TEXT", "SEARCH_KNOWLEDGE",
        "PREPARE_PATCH", "APPLY_PATCH", "RUN_CHECK", "SHOW_DIFF",
        "RESTORE_CHANGE_SET", "ASK_USER", "SUBMIT_RESULT", "ABORT"
      ]
    },
    "arguments": {"type": "object"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["REPOSITORY_STATUS", "SHOW_DIFF"]}}},
      "then": {"properties": {"arguments": {"type": "object", "additionalProperties": false}}}
    },
    {
      "if": {"properties": {"kind": {"const": "LIST_FILES"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "max_results": {"type": "integer", "minimum": 1, "maximum": 10000}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "READ_FILE"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object", "additionalProperties": false, "required": ["path"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "max_bytes": {"type": "integer", "minimum": 1, "maximum": 2000000}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "SEARCH_TEXT"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object", "additionalProperties": false, "required": ["query"],
            "properties": {
              "query": {"type": "string", "minLength": 1, "maxLength": 4096},
              "paths": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
              "case_sensitive": {"type": "boolean"},
              "max_results": {"type": "integer", "minimum": 1, "maximum": 1000}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "SEARCH_KNOWLEDGE"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object", "additionalProperties": false, "required": ["query"],
            "properties": {
              "query": {"type": "string", "minLength": 1, "maxLength": 4096},
              "scopes": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "limit": {"type": "integer", "minimum": 1, "maximum": 200}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "PREPARE_PATCH"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object", "additionalProperties": false, "required": ["operations"],
            "properties": {
              "operations": {
                "type": "array", "minItems": 1, "maxItems": 100,
                "items": {"$ref": "#/$defs/patchOperation"}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "APPLY_PATCH"}}},
      "then": {"properties": {"arguments": {"$ref": "#/$defs/applyPatch"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "RUN_CHECK"}}},
      "then": {"properties": {"arguments": {"$ref": "#/$defs/runCheck"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "RESTORE_CHANGE_SET"}}},
      "then": {"properties": {"arguments": {"$ref": "#/$defs/restoreChangeSet"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "ASK_USER"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object", "additionalProperties": false, "required": ["question"],
            "properties": {
              "question": {"type": "string", "minLength": 1, "maxLength": 4000},
              "choices": {"type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "SUBMIT_RESULT"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object", "additionalProperties": false, "required": ["artifact_ids", "summary", "risks", "citations"],
            "properties": {
              "artifact_ids": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "summary": {"type": "string", "minLength": 1, "maxLength": 10000},
              "risks": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "citations": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "ABORT"}}},
      "then": {
        "properties": {
          "arguments": {
            "type": "object", "additionalProperties": false, "required": ["reason"],
            "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 2000}}
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$)).+$"},
    "applyPatch": {"type": "object", "additionalProperties": false, "required": ["patch_id", "approval_id", "operation_id"], "properties": {"patch_id": {"$ref": "#/$defs/identifier"}, "approval_id": {"$ref": "#/$defs/identifier"}, "operation_id": {"$ref": "#/$defs/identifier"}}},
    "runCheck": {"type": "object", "additionalProperties": false, "required": ["check_id", "operation_id"], "properties": {"check_id": {"$ref": "#/$defs/identifier"}, "operation_id": {"$ref": "#/$defs/identifier"}}},
    "restoreChangeSet": {"type": "object", "additionalProperties": false, "required": ["change_set_id", "operation_id"], "properties": {"change_set_id": {"$ref": "#/$defs/identifier"}, "operation_id": {"$ref": "#/$defs/identifier"}}},
    "patchOperation": {
      "type": "object", "additionalProperties": false, "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["CREATE", "MODIFY", "DELETE", "RENAME"]},
        "path": {"$ref": "#/$defs/path"},
        "before_digest": {"type": "string", "minLength": 1, "maxLength": 80},
        "content": {"type": "string", "maxLength": 2000000},
        "new_path": {"$ref": "#/$defs/path"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "CREATE"}}}, "then": {"required": ["content"], "not": {"required": ["before_digest"]}}},
        {"if": {"properties": {"kind": {"const": "MODIFY"}}}, "then": {"required": ["before_digest", "content"]}},
        {"if": {"properties": {"kind": {"const": "DELETE"}}}, "then": {"required": ["before_digest"], "not": {"anyOf": [{"required": ["content"]}, {"required": ["new_path"]}]}}},
        {"if": {"properties": {"kind": {"const": "RENAME"}}}, "then": {"required": ["before_digest", "new_path"], "not": {"required": ["content"]}}}
      ]
    }
  }
}
