{
  "name": "counter-quality-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "fastify": "5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@types/node": "24.13.3",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
