From 68f3302fb663388b7d819aa12b9118f55ea1568d Mon Sep 17 00:00:00 2001
From: Seungwoo Kim <seungwoo7050@naver.com>
Date: Thu, 23 Oct 2025 20:26:00 +0900
Subject: [PATCH] test(web): 기능별 검사 경계 구성

diff --git a/src/app.test.ts b/src/app.test.ts
index 7c021c2..a1b1f12 100644
--- a/src/app.test.ts
+++ b/src/app.test.ts
@@ -1,3 +1,9 @@
-import { it } from "vitest";
-// TODO: `buildApp`과 `app.inject`로 POST `/counter/increment` 요청을 검증해 주세요.
-it.todo("increments through HTTP");
+import { expect, it } from "vitest";
+import { buildApp } from "./app";
+it("increments through HTTP", async () => {
+  const app = buildApp();
+  await app.ready();
+  const response = await app.inject({ method: "POST", url: "/counter/increment" });
+  expect(response.json()).toEqual({ value: 1 });
+  await app.close();
+});
diff --git a/src/counter.test.ts b/src/counter.test.ts
index 96a5a9a..2be4a36 100644
--- a/src/counter.test.ts
+++ b/src/counter.test.ts
@@ -1,6 +1,4 @@
 import { expect, it } from "vitest";
 import { reduceCounter } from "./counter";
-// TODO: `increment`와 `reset`의 기본 동작을 확인하는 단위 검사를 작성해 주세요.
-it.todo("increments deterministically");
-it.todo("resets");
-void expect; void reduceCounter;
+it("increments deterministically", () => { expect(reduceCounter(2, { type: "increment" })).toBe(3); });
+it("resets", () => { expect(reduceCounter(2, { type: "reset" })).toBe(0); });
diff --git a/tests/counter.spec.ts b/tests/counter.spec.ts
index 8622cd7..ab70eff 100644
--- a/tests/counter.spec.ts
+++ b/tests/counter.spec.ts
@@ -1,3 +1,7 @@
-import { test } from "@playwright/test";
-// TODO: `getByRole`과 화면 상태를 자동으로 기다리는 단언으로 사용자 흐름을 검증해 주세요.
-test.fixme("user increments the counter");
+import { expect, test } from "@playwright/test";
+test("user increments the counter", async ({ page }) => {
+  await page.goto("/");
+  await expect(page.getByRole("status")).toHaveText("0");
+  await page.getByRole("button", { name: "증가" }).click();
+  await expect(page.getByRole("status")).toHaveText("1");
+});
--
