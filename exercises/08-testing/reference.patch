diff --git a/src/counter.test.ts b/src/counter.test.ts
index 5dc450c..c7ce5a7 100644
--- a/src/counter.test.ts
+++ b/src/counter.test.ts
@@ -1,7 +1,9 @@
 import { expect, it } from "vitest";
 import { reduceCounter } from "./counter";
-// TODO: `increment`, 0 경계의 `decrement`와 `reset`을 확인하는 단위 검사를 작성해 주세요.
-it.todo("increments deterministically");
-it.todo("decrements without crossing zero");
-it.todo("resets");
-void expect; void reduceCounter;
+// [Implementation 2] 순수 함수의 0 경계는 가장 작은 unit test에서 deterministic하게 증명합니다.
+it("increments deterministically", () => { expect(reduceCounter(2, { type: "increment" })).toBe(3); });
+it("decrements without crossing zero", () => {
+  expect(reduceCounter(2, { type: "decrement" })).toBe(1);
+  expect(reduceCounter(0, { type: "decrement" })).toBe(0);
+});
+it("resets", () => { expect(reduceCounter(2, { type: "reset" })).toBe(0); });
diff --git a/src/counter.ts b/src/counter.ts
index 5370b38..96d9fd7 100644
--- a/src/counter.ts
+++ b/src/counter.ts
@@ -1,6 +1,7 @@
+// [Implementation 1] framework 밖의 순수 transition이 counter invariant와 경계값 behavior를 소유합니다.
 export type CounterAction = { type: "increment" } | { type: "decrement" } | { type: "reset" };
 export function reduceCounter(value: number, action: CounterAction): number {
   if (action.type === "increment") return value + 1;
-  if (action.type === "decrement") return value - 1; // TODO: 0 아래로 내려가지 않게 고쳐 주세요.
+  if (action.type === "decrement") return Math.max(0, value - 1);
   return 0;
 }
