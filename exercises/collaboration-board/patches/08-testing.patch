diff --git a/apps/web/app/boards/[id]/page.tsx b/apps/web/app/boards/[id]/page.tsx
index 38d0f08..9b5ae58 100644
--- a/apps/web/app/boards/[id]/page.tsx
+++ b/apps/web/app/boards/[id]/page.tsx
@@ -7,6 +7,9 @@ import { BoardCanvas } from "../../../components/BoardCanvas";

 const WS_URL = process.env.NEXT_PUBLIC_WS_URL ?? "ws://localhost:4000/ws";

