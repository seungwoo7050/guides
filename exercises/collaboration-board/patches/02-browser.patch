Subject: [PATCH] feat(board): 보드 화면 골격 추가
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 README.md                        |  3 ++-
 apps/web/app/globals.css         | 12 ++++++++++++
 apps/web/app/layout.tsx          | 16 ++++++++++++++++
 apps/web/app/loading.tsx         |  1 +
 apps/web/app/not-found.tsx       |  1 +
 apps/web/components/AppShell.tsx | 26 ++++++++++++++++++++++++++
 apps/web/postcss.config.mjs      |  1 +
 apps/web/tailwind.config.ts      |  2 ++
 8 files changed, 61 insertions(+), 1 deletion(-)
 create mode 100644 apps/web/app/globals.css
 create mode 100644 apps/web/app/layout.tsx
 create mode 100644 apps/web/app/loading.tsx
 create mode 100644 apps/web/app/not-found.tsx
 create mode 100644 apps/web/components/AppShell.tsx
 create mode 100644 apps/web/postcss.config.mjs
 create mode 100644 apps/web/tailwind.config.ts

diff --git a/README.md b/README.md
index 74dd633..9673211 100644
--- a/README.md
+++ b/README.md
@@ -1,7 +1,8 @@
 # 실시간 협업 보드
 
-Fastify API와 Next.js 화면을 한 pnpm 작업 공간에서 개발하기 위한 골격을 구성했습니다. Node.js 24와 pnpm 10을 사용합니다.
+Fastify API와 Next.js 화면을 한 pnpm 작업 공간에서 개발합니다. 공통 레이아웃은 키보드로 건너뛸 수 있는 링크와 현재 위치를 알리는 탐색 구조를 제공합니다.
 
 ```sh
 pnpm install --frozen-lockfile
+pnpm --filter @board/web dev
 ```
diff --git a/apps/web/app/globals.css b/apps/web/app/globals.css
new file mode 100644
index 0000000..29b26fb
--- /dev/null
+++ b/apps/web/app/globals.css
@@ -0,0 +1,12 @@
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+:root { color: #172033; background: #f4f7fb; font-family: system-ui, sans-serif; }
+* { box-sizing: border-box; }
+body { margin: 0; }
+a { color: inherit; }
+.focus-ring:focus-visible { outline: 3px solid #f59e0b; outline-offset: 3px; }
+.card { border: 1px solid #dbe3ee; border-radius: .75rem; background: white; box-shadow: 0 8px 24px rgb(15 23 42 / .06); }
+.skip-link { position: fixed; left: 1rem; top: 1rem; z-index: 50; transform: translateY(-200%); background: #111827; color: white; padding: .75rem; }
+.skip-link:focus { transform: none; }
diff --git a/apps/web/app/layout.tsx b/apps/web/app/layout.tsx
new file mode 100644
index 0000000..efd31d4
--- /dev/null
+++ b/apps/web/app/layout.tsx
@@ -0,0 +1,16 @@
+import type { Metadata } from "next";
+import "./globals.css";
+
+export const metadata: Metadata = {
+  title: "협업 보드",
+  description: "실시간 협업 보드 학습 예제"
+};
+
+export default function RootLayout({ children }: { children: React.ReactNode }) {
+  return <html lang="ko">
+    <body>
+      <a className="skip-link" href="#main">본문으로 건너뛰기</a>
+      {children}
+    </body>
+  </html>;
+}
diff --git a/apps/web/app/loading.tsx b/apps/web/app/loading.tsx
new file mode 100644
index 0000000..032cfeb
--- /dev/null
+++ b/apps/web/app/loading.tsx
@@ -0,0 +1 @@
+export default function Loading() { return <p role="status" className="p-8">화면을 불러오는 중</p>; }
diff --git a/apps/web/app/not-found.tsx b/apps/web/app/not-found.tsx
new file mode 100644
index 0000000..8c16eb8
--- /dev/null
+++ b/apps/web/app/not-found.tsx
@@ -0,0 +1 @@
+export default function NotFound() { return <main className="mx-auto w-[min(40rem,calc(100%-2rem))] py-12"><h1 className="text-3xl font-black">찾을 수 없습니다</h1></main>; }
diff --git a/apps/web/components/AppShell.tsx b/apps/web/components/AppShell.tsx
new file mode 100644
index 0000000..a5ab193
--- /dev/null
+++ b/apps/web/components/AppShell.tsx
@@ -0,0 +1,26 @@
+import Link from "next/link";
+
+export function AppShell({ children }: { children: React.ReactNode }) {
+  return <>
+    <header className="border-b border-slate-200 bg-white">
+      <nav
+        aria-label="주 메뉴"
+        className="mx-auto flex w-[min(72rem,calc(100%-2rem))] items-center justify-between py-4"
+      >
+        <Link className="focus-ring text-xl font-black" href="/">협업 보드</Link>
+        <div className="flex gap-4 text-sm font-bold">
+          <Link href="/">내 보드</Link>
+          <Link href="/activity">활동 기록</Link>
+          <Link href="/admin">관리</Link>
+        </div>
+      </nav>
+    </header>
+    <main
+      id="main"
+      tabIndex={-1}
+      className="mx-auto w-[min(72rem,calc(100%-2rem))] py-8"
+    >
+      {children}
+    </main>
+  </>;
+}
diff --git a/apps/web/postcss.config.mjs b/apps/web/postcss.config.mjs
new file mode 100644
