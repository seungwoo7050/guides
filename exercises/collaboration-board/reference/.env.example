# [Implementation 1-1]
# Node server만 읽는 DB·origin 설정과 browser bundle에 공개되는 NEXT_PUBLIC 값을 분리합니다.
# 실제 secret은 이 예제 파일이 아니라 실행 환경이 소유합니다.
PORT=4000
DATABASE_URL=postgres://board:board@localhost:5432/board
WEB_ORIGINS=http://localhost:3000,http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
LOG_LEVEL=info
