{
  "schemaVersion": 2,
  "title": "Multi-tenancy contract",
  "requiredPaths": [
    "/status",
    "/tenantDefinition",
    "/profiles",
    "/isolationAxes",
    "/quotas",
    "/fairness",
    "/telemetry",
    "/cost",
    "/lifecycle"
  ],
  "nonEmptyPaths": [
    "/tenantDefinition/unit",
    "/tenantDefinition/securityMeaning",
    "/quotas/increasePath",
    "/fairness/systemReserve",
    "/telemetry/queryIsolation",
    "/lifecycle/retirementEvidence"
  ],
  "minimumItems": {
    "/profiles": 2,
    "/isolationAxes": 6,
    "/quotas/types": 5,
    "/lifecycle/stages": 4
  },
  "arrayItemRequiredFields": {
    "/profiles": [
      "name",
      "trust",
      "boundaries",
      "support",
      "costTradeoff"
    ],
    "/isolationAxes": [
      "axis",
      "shared",
      "isolated",
      "evidence"
    ],
    "/quotas/types": [
      "resource",
      "limit",
      "owner"
    ],
    "/lifecycle/stages": [
      "stage",
      "owner",
      "condition"
    ]
  },
  "arrayUniqueBy": {
    "/profiles": "name",
    "/isolationAxes": "axis",
    "/quotas/types": "resource",
    "/lifecycle/stages": "stage"
  },
  "containsValues": {
    "/fairness/priorities": [
      "platform-system",
      "production",
      "preview"
    ]
  },
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/tenantDefinition": "object",
    "/profiles": "array",
    "/isolationAxes": "array",
    "/quotas": "object",
    "/fairness": "object",
    "/telemetry": "object",
    "/cost": "object",
    "/lifecycle": "object"
  },
  "arrayContainsObjects": {
    "/profiles": [
      {
        "name": "development-shared"
      },
      {
        "name": "production-standard"
      },
      {
        "name": "high-isolation"
      }
    ],
    "/isolationAxes": [
      {
        "axis": "identity"
      },
      {
        "axis": "network"
      },
      {
        "axis": "storage"
      },
      {
        "axis": "telemetry"
      },
      {
        "axis": "control-plane"
      }
    ],
    "/quotas/types": [
      {
        "resource": "controller concurrency",
        "limit": "per tenant work queue"
      }
    ]
  },
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/fairness/overloadAction",
          "/lifecycle/retirementEvidence"
        ],
        "nonEmptyPaths": [
          "/fairness/overloadAction",
          "/lifecycle/retirementEvidence"
        ]
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
