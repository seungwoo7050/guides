{
  "schemaVersion": 2,
  "title": "Delivery and GitOps contract",
  "requiredPaths": [
    "/status",
    "/artifactChain",
    "/identities",
    "/promotionGates",
    "/gitops",
    "/driftPolicies",
    "/prune",
    "/breakGlass",
    "/rollback"
  ],
  "nonEmptyPaths": [
    "/gitops/desiredSource",
    "/gitops/observedRevision",
    "/prune/guard",
    "/breakGlass/closeCondition",
    "/rollback/decisionRule"
  ],
  "minimumItems": {
    "/artifactChain": 5,
    "/identities": 3,
    "/promotionGates": 3,
    "/driftPolicies": 4
  },
  "arrayItemRequiredFields": {
    "/artifactChain": [
      "stage",
      "identity",
      "evidence"
    ],
    "/identities": [
      "role",
      "scope",
      "credential"
    ],
    "/promotionGates": [
      "environment",
      "requirements",
      "failureAction"
    ],
    "/driftPolicies": [
      "type",
      "action",
      "owner"
    ]
  },
  "arrayUniqueBy": {
    "/artifactChain": "stage",
    "/identities": "role",
    "/promotionGates": "environment",
    "/driftPolicies": "type"
  },
  "containsValues": {},
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/artifactChain": "array",
    "/identities": "array",
    "/promotionGates": "array",
    "/gitops": "object",
    "/driftPolicies": "array",
    "/prune": "object",
    "/breakGlass": "object",
    "/rollback": "object"
  },
  "arrayContainsObjects": {
    "/artifactChain": [
      {
        "stage": "artifact",
        "identity": "OCI digest"
      },
      {
        "stage": "deployment",
        "evidence": "desired commit + observed digest + smoke"
      }
    ],
    "/identities": [
      {
        "role": "pull-request-validation",
        "credential": "ephemeral read-only; no production secret"
      },
      {
        "role": "trusted-build",
        "credential": "short-lived builder identity"
      },
      {
        "role": "deployment-controller",
        "credential": "environment-scoped workload identity"
      }
    ],
    "/promotionGates": [
      {
        "environment": "production",
        "failureAction": "do not change desired production revision"
      }
    ]
  },
  "pathComparisons": [
    {
      "left": "/gitops/desiredSource",
      "op": "ne",
      "right": "/gitops/observedRevision"
    }
  ],
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/breakGlass/closeCondition",
          "/rollback/decisionRule"
        ],
        "nonEmptyPaths": [
          "/breakGlass/closeCondition",
          "/rollback/decisionRule"
        ]
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
