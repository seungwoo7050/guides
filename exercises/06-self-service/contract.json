{
  "schemaVersion": 2,
  "title": "Self-service golden path",
  "requiredPaths": [
    "/status",
    "/api",
    "/conditionTypes",
    "/errors",
    "/catalog",
    "/profile",
    "/lifecycle",
    "/escapeHatch",
    "/automationPaths"
  ],
  "nonEmptyPaths": [
    "/api/version",
    "/api/resourceIdentity",
    "/api/statusUrl",
    "/catalog/metadataSource",
    "/catalog/runtimeSource",
    "/profile/version",
    "/escapeHatch/expiryRule"
  ],
  "minimumItems": {
    "/conditionTypes": 4,
    "/errors": 5,
    "/lifecycle": 8,
    "/automationPaths": 2
  },
  "arrayItemRequiredFields": {
    "/errors": [
      "code",
      "retryable",
      "owner",
      "remediation"
    ],
    "/lifecycle": [
      "stage",
      "success",
      "failure",
      "evidence"
    ],
    "/automationPaths": [
      "client",
      "contract"
    ]
  },
  "arrayUniqueBy": {
    "/errors": "code",
    "/lifecycle": "stage"
  },
  "containsValues": {
    "/conditionTypes": [
      "Ready",
      "Progressing",
      "Blocked",
      "Degraded"
    ]
  },
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/api": "object",
    "/conditionTypes": "array",
    "/errors": "array",
    "/errors/*/retryable": "boolean",
    "/catalog": "object",
    "/profile": "object",
    "/lifecycle": "array",
    "/escapeHatch": "object",
    "/automationPaths": "array"
  },
  "arrayContainsObjects": {
    "/errors": [
      {
        "code": "INVALID_PROFILE",
        "retryable": false
      },
      {
        "code": "DEPENDENCY_TIMEOUT",
        "retryable": true
      },
      {
        "code": "CONTROLLER_INVARIANT",
        "retryable": false
      }
    ],
    "/lifecycle": [
      {
        "stage": "Retire"
      }
    ]
  },
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/api/idempotency",
          "/profile/update"
        ],
        "nonEmptyPaths": [
          "/api/idempotency",
          "/profile/update"
        ],
        "valueTypes": {
          "/automationPaths": "array"
        }
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
