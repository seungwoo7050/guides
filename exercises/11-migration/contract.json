{
  "schemaVersion": 2,
  "title": "Platform migration plan",
  "requiredPaths": [
    "/status",
    "/change",
    "/inventory",
    "/compatibility",
    "/preflight",
    "/waves",
    "/abortCriteria",
    "/rollback",
    "/deprecation",
    "/metrics"
  ],
  "nonEmptyPaths": [
    "/change/sourceVersion",
    "/change/targetVersion",
    "/change/semanticDifference",
    "/inventory/source",
    "/rollback/boundary",
    "/deprecation/deadline",
    "/deprecation/completionEvidence"
  ],
  "minimumItems": {
    "/inventory/categories": 5,
    "/compatibility": 5,
    "/preflight": 5,
    "/waves": 4,
    "/abortCriteria": 3,
    "/metrics": 4
  },
  "arrayItemRequiredFields": {
    "/inventory/categories": [
      "item",
      "owner",
      "query"
    ],
    "/compatibility": [
      "dimension",
      "supported",
      "evidence"
    ],
    "/preflight": [
      "check",
      "blockReason",
      "owner"
    ],
    "/waves": [
      "name",
      "targets",
      "entry",
      "exit"
    ],
    "/abortCriteria": [
      "signal",
      "threshold",
      "action"
    ],
    "/metrics": [
      "name",
      "meaning",
      "owner"
    ]
  },
  "arrayUniqueBy": {
    "/inventory/categories": "item",
    "/compatibility": "dimension",
    "/waves": "name",
    "/metrics": "name"
  },
  "containsValues": {},
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/change": "object",
    "/inventory": "object",
    "/compatibility": "array",
    "/preflight": "array",
    "/waves": "array",
    "/abortCriteria": "array",
    "/rollback": "object",
    "/deprecation": "object",
    "/metrics": "array"
  },
  "arrayContainsObjects": {
    "/compatibility": [
      {
        "dimension": "stored status"
      },
      {
        "dimension": "identity"
      }
    ],
    "/waves": [
      {
        "name": "platform-fixtures"
      },
      {
        "name": "production-canary"
      }
    ],
    "/abortCriteria": [
      {
        "signal": "unknown state conversion"
      }
    ]
  },
  "pathComparisons": [
    {
      "left": "/change/sourceVersion",
      "op": "ne",
      "right": "/change/targetVersion"
    }
  ],
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/rollback/procedure",
          "/rollback/forwardRepair"
        ],
        "nonEmptyPaths": [
          "/rollback/procedure",
          "/rollback/forwardRepair"
        ]
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
