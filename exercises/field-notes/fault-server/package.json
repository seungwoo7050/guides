{
  "name": "@field-notes/fault-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic local test double for Field Notes sync failures",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "start": "node src/http.ts"
  },
  "devDependencies": {
    "@types/node": "~26.2.0",
    "typescript": "~6.0.3"
  }
}
