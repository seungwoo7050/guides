{
  "name": "@field-notes/release-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime validation for Field Notes build, install, signing, and store evidence",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "digest:directory-tree": "node src/directory-tree-cli.ts",
    "validate:fixtures": "node src/cli.ts fixtures/android-aab.json fixtures/ios-ipa.json",
    "validate:eas-profile": "node src/eas-profile-cli.ts ../reference/eas.json"
  },
  "devDependencies": {
    "@types/node": "~26.2.0",
    "typescript": "~6.0.3"
  }
}
