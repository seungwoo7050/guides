{
  "name": "@field-notes/reference",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:stage01": "jest --runInBand --runTestsByPath tests/stage01-navigation.test.ts tests/in-memory-repository.test.ts tests/record-components.test.tsx",
    "test:stage02": "jest --runInBand --runTestsByPath tests/stage02-transaction.test.ts tests/stage02-migration.test.ts tests/stage02-files.test.ts",
    "test:stage03": "jest --runInBand --runTestsByPath tests/stage03-adapters.test.ts tests/stage03-media-lifecycle.test.ts tests/stage03-location.test.ts tests/stage03-native-config.test.ts",
    "bundle:android": "expo export --platform android --output-dir dist/android --clear",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios --clear"
  },
  "dependencies": {
    "@field-notes/shared": "0.1.0",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.7",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-router": "~57.0.11",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "watchman": false,
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  }
}
