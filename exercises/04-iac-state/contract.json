{
  "schemaVersion": 2,
  "title": "IaC state contract",
  "requiredPaths": [
    "/status",
    "/stateUnits",
    "/resourceMappings",
    "/lockingAndSecurity",
    "/planApply",
    "/driftPolicy",
    "/migration",
    "/destroy"
  ],
  "nonEmptyPaths": [
    "/lockingAndSecurity/backend",
    "/lockingAndSecurity/lockRule",
    "/lockingAndSecurity/restoreEvidence",
    "/planApply/stalePlanRule",
    "/migration/rollbackBoundary",
    "/destroy/completionEvidence"
  ],
  "minimumItems": {
    "/stateUnits": 3,
    "/resourceMappings": 3,
    "/driftPolicy": 4,
    "/migration/steps": 4
  },
  "arrayItemRequiredFields": {
    "/stateUnits": [
      "id",
      "owner",
      "scope",
      "blastRadius"
    ],
    "/resourceMappings": [
      "address",
      "externalIdentity",
      "writer",
      "importOrAdopt"
    ],
    "/driftPolicy": [
      "type",
      "detect",
      "action",
      "owner"
    ],
    "/migration/steps": [
      "step",
      "precondition",
      "evidence"
    ]
  },
  "arrayUniqueBy": {
    "/stateUnits": "id",
    "/resourceMappings": "address",
    "/driftPolicy": "type"
  },
  "containsValues": {
    "/destroy/guards": [
      "explicit environment/resource selector",
      "retention policy"
    ]
  },
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {
    "/planApply/stalePlanRule": "(?is).*rejects.*(source|state|policy).*"
  },
  "valueTypes": {
    "/status": "string",
    "/stateUnits": "array",
    "/resourceMappings": "array",
    "/lockingAndSecurity": "object",
    "/planApply": "object",
    "/driftPolicy": "array",
    "/migration": "object",
    "/destroy": "object"
  },
  "arrayContainsObjects": {
    "/driftPolicy": [
      {
        "type": "authorized-emergency"
      },
      {
        "type": "external-controller",
        "action": "remove duplicate writer or split field ownership"
      }
    ]
  },
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/lockingAndSecurity/restoreEvidence",
          "/destroy/completionEvidence"
        ],
        "nonEmptyPaths": [
          "/lockingAndSecurity/restoreEvidence",
          "/destroy/completionEvidence"
        ],
        "valueTypes": {
          "/migration/steps": "array"
        }
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
