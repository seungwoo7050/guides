{
  "schemaVersion": 2,
  "title": "Platform capability contract",
  "requiredPaths": [
    "/status",
    "/capability",
    "/request",
    "/conditions",
    "/ownership",
    "/externalEffects",
    "/deletion",
    "/escapeHatch",
    "/support"
  ],
  "nonEmptyPaths": [
    "/capability/name",
    "/capability/version",
    "/capability/owner",
    "/request/resourceIdentity",
    "/request/idempotency",
    "/deletion/finalCondition",
    "/support/escalation"
  ],
  "minimumItems": {
    "/conditions": 4,
    "/ownership": 4,
    "/externalEffects": 3
  },
  "arrayItemRequiredFields": {
    "/conditions": [
      "type",
      "meaning",
      "userAction",
      "failureOwner"
    ],
    "/ownership": [
      "boundary",
      "writer",
      "reader",
      "failureOwner"
    ],
    "/externalEffects": [
      "effect",
      "writer",
      "externalIdentity",
      "retryRule",
      "cleanup"
    ]
  },
  "arrayUniqueBy": {
    "/conditions": "type",
    "/ownership": "boundary"
  },
  "containsValues": {
    "/conditionTypes": [
      "Ready",
      "Progressing",
      "Blocked",
      "Degraded"
    ]
  },
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/capability": "object",
    "/request": "object",
    "/conditionTypes": "array",
    "/conditions": "array",
    "/ownership": "array",
    "/externalEffects": "array",
    "/deletion": "object",
    "/escapeHatch": "object",
    "/support": "object"
  },
  "arrayContainsObjects": {
    "/conditions": [
      {
        "type": "Ready",
        "failureOwner": "none"
      },
      {
        "type": "Blocked",
        "failureOwner": "request or policy owner"
      }
    ]
  },
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/conditionTypes",
          "/deletion/finalCondition"
        ],
        "nonEmptyPaths": [
          "/deletion/finalCondition"
        ],
        "valueTypes": {
          "/conditionTypes": "array"
        }
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
