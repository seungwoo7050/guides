{
  "schemaVersion": 2,
  "title": "Platform product brief",
  "requiredPaths": [
    "/status",
    "/product",
    "/users",
    "/currentJourney",
    "/evidence",
    "/outcomes",
    "/firstCapability",
    "/nonGoals",
    "/risks"
  ],
  "nonEmptyPaths": [
    "/product/name",
    "/product/owner",
    "/product/problemStatement",
    "/firstCapability/name",
    "/firstCapability/exitEvidence"
  ],
  "minimumItems": {
    "/users": 2,
    "/currentJourney": 4,
    "/evidence": 3,
    "/outcomes": 2,
    "/nonGoals": 2,
    "/risks": 2
  },
  "arrayItemRequiredFields": {
    "/users": [
      "id",
      "role",
      "job",
      "pain"
    ],
    "/currentJourney": [
      "step",
      "owner",
      "waitOrFailure",
      "evidence"
    ],
    "/evidence": [
      "type",
      "source",
      "finding"
    ],
    "/outcomes": [
      "name",
      "measure",
      "target",
      "guardrail"
    ],
    "/nonGoals": [
      "item",
      "reason"
    ],
    "/risks": [
      "risk",
      "owner",
      "mitigation"
    ]
  },
  "arrayUniqueBy": {
    "/users": "id",
    "/outcomes": "name"
  },
  "containsValues": {},
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/product": "object",
    "/users": "array",
    "/currentJourney": "array",
    "/evidence": "array",
    "/outcomes": "array",
    "/firstCapability": "object",
    "/nonGoals": "array",
    "/risks": "array",
    "/users/*/id": "string",
    "/outcomes/*/guardrail": "string"
  },
  "arrayContainsObjects": {
    "/users": [
      {
        "role": "application developer"
      },
      {
        "role": "platform operator"
      }
    ]
  },
  "pathComparisons": [
    {
      "left": "/product/name",
      "op": "ne",
      "right": "/product/owner"
    }
  ],
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/firstCapability/scope"
        ],
        "nonEmptyPaths": [
          "/firstCapability/scope"
        ],
        "valueTypes": {
          "/firstCapability/scope": "string"
        }
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
