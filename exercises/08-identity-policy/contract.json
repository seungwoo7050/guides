{
  "schemaVersion": 2,
  "title": "Identity policy and supply-chain contract",
  "requiredPaths": [
    "/status",
    "/identities",
    "/secretLifecycle",
    "/policyStages",
    "/exception",
    "/breakGlass",
    "/trustChain",
    "/auditEvents",
    "/containment"
  ],
  "nonEmptyPaths": [
    "/secretLifecycle/sourceOwner",
    "/secretLifecycle/materialization",
    "/secretLifecycle/revocation",
    "/exception/expiryRule",
    "/breakGlass/closeCondition",
    "/containment/recoveryEvidence"
  ],
  "minimumItems": {
    "/identities": 3,
    "/policyStages": 4,
    "/trustChain": 5,
    "/auditEvents": 5
  },
  "arrayItemRequiredFields": {
    "/identities": [
      "type",
      "attestation",
      "scope",
      "ttl",
      "revocation"
    ],
    "/policyStages": [
      "stage",
      "input",
      "decision",
      "feedback"
    ],
    "/trustChain": [
      "stage",
      "subject",
      "artifactOrState",
      "verification"
    ],
    "/auditEvents": [
      "event",
      "identity",
      "redaction",
      "retentionOwner"
    ]
  },
  "arrayUniqueBy": {
    "/identities": "type",
    "/policyStages": "stage",
    "/trustChain": "stage",
    "/auditEvents": "event"
  },
  "containsValues": {},
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/identities": "array",
    "/secretLifecycle": "object",
    "/policyStages": "array",
    "/exception": "object",
    "/breakGlass": "object",
    "/trustChain": "array",
    "/auditEvents": "array",
    "/containment": "object"
  },
  "arrayContainsObjects": {
    "/identities": [
      {
        "type": "human"
      },
      {
        "type": "workload"
      },
      {
        "type": "automation",
        "ttl": "job/operation lifetime"
      }
    ],
    "/policyStages": [
      {
        "stage": "local/PR"
      },
      {
        "stage": "build"
      },
      {
        "stage": "platform API"
      },
      {
        "stage": "admission/runtime"
      }
    ],
    "/trustChain": [
      {
        "stage": "source"
      },
      {
        "stage": "builder"
      },
      {
        "stage": "artifact"
      },
      {
        "stage": "promotion"
      },
      {
        "stage": "runtime"
      }
    ]
  },
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/exception/expiryRule",
          "/breakGlass/closeCondition"
        ],
        "nonEmptyPaths": [
          "/exception/expiryRule",
          "/breakGlass/closeCondition"
        ]
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
