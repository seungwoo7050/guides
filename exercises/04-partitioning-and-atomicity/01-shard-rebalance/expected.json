  "manual_review": [
    {
      "id": "durable-migration-state",
      "question": "PREPARE, COPY, CATCH_UP, FENCE, CUTOVER, CLEANUP 각각의 durable state와 restart 행동을 정의했는가?",
      "required_evidence": ["phase 전이표", "migration manifest", "crash resume source"]
    },
    {
      "id": "fencing-boundaries",
      "question": "stale router·source·target이 각각 write를 승인하지 못하도록 검사 위치를 정했는가?",
      "required_evidence": ["epoch 비교 위치", "거절/redirect status", "authority 불변식"]
    }
  ],
  "limits": [
    "단일 shard와 단일 migration만 다룬다.",
    "cross-shard transaction과 실제 storage cleanup 비용을 검증하지 않는다."
  ]
}
