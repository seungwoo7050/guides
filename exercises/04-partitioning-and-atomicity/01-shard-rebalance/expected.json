        "before_e7": "G1",
        "after_e7_before_e9": null,
        "after_e9": "G2"
      }
    },
    {
      "id": "stale-router-retry",
      "fixture": "rebalance.json#safe-plan/e10-e11",
      "observation": "w3 application",
      "expected": {
        "e10_status": "STALE_EPOCH",
        "applied_at": "G2",
        "applied_index": 123,
        "effect_count": 1
      }
    },
    {
      "id": "unsafe-index-conflict",
      "fixture": "rebalance.json#unsafe-early-cutover",
      "observation": "late source delta versus target write",
      "expected": {
        "source_write": "w1",
        "source_index": 121,
        "target_write": "w2",
        "target_index": 121,
        "safe": false
      }
