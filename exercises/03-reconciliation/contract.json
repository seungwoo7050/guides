{
  "schemaVersion": 2,
  "title": "Reconciliation design",
  "requiredPaths": [
    "/status",
    "/resourceModel",
    "/conditionTypes",
    "/reconcileSteps",
    "/failureClasses",
    "/fieldOwnership",
    "/finalization",
    "/evidence"
  ],
  "nonEmptyPaths": [
    "/resourceModel/desiredSource",
    "/resourceModel/observedSource",
    "/resourceModel/generationRule",
    "/finalization/terminalCondition"
  ],
  "minimumItems": {
    "/conditionTypes": 4,
    "/reconcileSteps": 5,
    "/failureClasses": 4,
    "/fieldOwnership": 3,
    "/evidence": 4
  },
  "arrayItemRequiredFields": {
    "/reconcileSteps": [
      "name",
      "input",
      "idempotency",
      "evidence",
      "onFailure"
    ],
    "/failureClasses": [
      "class",
      "retryable",
      "condition",
      "action"
    ],
    "/fieldOwnership": [
      "field",
      "writer",
      "conflictPolicy"
    ],
    "/evidence": [
      "signal",
      "identity",
      "purpose"
    ]
  },
  "arrayUniqueBy": {
    "/reconcileSteps": "name",
    "/failureClasses": "class",
    "/fieldOwnership": "field"
  },
  "containsValues": {
    "/conditionTypes": [
      "Progressing",
      "Ready",
      "Blocked",
      "Degraded"
    ],
    "/finalization/steps": [
      "revoke credential",
      "orphan scan"
    ]
  },
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/resourceModel": "object",
    "/conditionTypes": "array",
    "/reconcileSteps": "array",
    "/failureClasses": "array",
    "/failureClasses/*/retryable": "boolean",
    "/fieldOwnership": "array",
    "/finalization": "object",
    "/evidence": "array"
  },
  "arrayContainsObjects": {
    "/failureClasses": [
      {
        "class": "transient-dependency",
        "retryable": true,
        "condition": "Progressing"
      },
      {
        "class": "invalid-input",
        "retryable": false,
        "condition": "Blocked"
      },
      {
        "class": "invariant-violation",
        "retryable": false,
        "condition": "Degraded"
      }
    ]
  },
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/finalization/steps",
          "/finalization/terminalCondition"
        ],
        "nonEmptyPaths": [
          "/finalization/terminalCondition"
        ],
        "valueTypes": {
          "/finalization/steps": "array"
        }
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
