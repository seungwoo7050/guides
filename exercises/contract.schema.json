{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seungwoo7050/guides/blob/computer-graphics/exercises/contract.schema.json",
  "title": "Computer Graphics Exercise Contract",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "related_docs",
    "required_artifacts",
    "invariants",
    "known_bad_mutations",
    "completion_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "related_docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "known_bad_mutations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "completion_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
