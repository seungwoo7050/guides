{
  "schema_version": 1,
  "exercise_id": "03-consensus-and-membership/02-log-reconciliation",
  "automated_checks": [
    {
      "id": "append-attempt-results",
      "fixture": "logs.json#conflicting-suffix",
      "observation": "AppendEntries acceptance in fixture order",
      "expected": {
        "a1": false,
        "a2": false,
        "a3": false,
        "a4": true
      }
    },
    {
      "id": "reconciled-log",
      "fixture": "logs.json#conflicting-suffix",
      "observation": "follower terms after a4",
      "expected": {
        "terms": [1, 1, 3, 4, 4, 7, 8],
        "match_index": 7,
        "next_index": 8
      }
    },
    {
      "id": "old-term-not-directly-committed",
      "fixture": "logs.json#old-term-majority/s1",
      "observation": "leader commit index under current-term rule",
      "expected": 2
    },
    {
      "id": "current-term-entry-commits-prefix",
      "fixture": "logs.json#old-term-majority/s2",
      "observation": "leader commit index after term-7 entry reaches quorum",
      "expected": 5
    }
  ],
  "manual_review": [
    {
      "id": "conflict-hint",
      "question": "term-based conflict hint와 index 단순 감소의 message 수를 비교했는가?",
      "required_evidence": ["nextIndex 전이표", "각 거절의 prevLogIndex/prevLogTerm"]
    },
    {
      "id": "visibility-order",
      "question": "replication부터 client reply까지의 상태 경계를 분리했는가?",
      "required_evidence": ["persist·commit·apply·reply 순서", "crash 가능한 경계"]
    }
  ],
  "limits": [
    "한 follower의 suffix repair만 검사한다.",
    "leader completeness 전체 proof나 snapshot 경계 reconciliation을 대신하지 않는다."
  ]
}
