{
  "schemaVersion": 2,
  "title": "Platform capstone plan",
  "requiredPaths": [
    "/status",
    "/product",
    "/resources",
    "/controlPlane",
    "/delivery",
    "/runtimeAndTenancy",
    "/security",
    "/operations",
    "/scenarios",
    "/uncheckedClaims",
    "/projectTransition"
  ],
  "nonEmptyPaths": [
    "/product/problem",
    "/product/outcome",
    "/controlPlane/readyEvidence",
    "/delivery/artifactIdentity",
    "/security/trustBoundary",
    "/operations/journeySlo",
    "/projectTransition/firstContribution"
  ],
  "minimumItems": {
    "/resources": 5,
    "/scenarios": 8,
    "/uncheckedClaims": 3,
    "/projectTransition/steps": 4
  },
  "arrayItemRequiredFields": {
    "/resources": [
      "kind",
      "owner",
      "desiredSource",
      "statusOwner",
      "deletePolicy"
    ],
    "/scenarios": [
      "name",
      "initialState",
      "event",
      "expectedState",
      "evidence",
      "owner"
    ],
    "/uncheckedClaims": [
      "claim",
      "whyUnchecked",
      "nextValidation"
    ],
    "/projectTransition/steps": [
      "step",
      "artifact",
      "completion"
    ]
  },
  "arrayUniqueBy": {
    "/resources": "kind",
    "/scenarios": "name"
  },
  "containsValues": {},
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/product": "object",
    "/resources": "array",
    "/controlPlane": "object",
    "/delivery": "object",
    "/runtimeAndTenancy": "object",
    "/security": "object",
    "/operations": "object",
    "/scenarios": "array",
    "/uncheckedClaims": "array",
    "/projectTransition": "object"
  },
  "arrayContainsObjects": {
    "/resources": [
      {
        "kind": "ServiceEnvironment"
      },
      {
        "kind": "Release"
      },
      {
        "kind": "CapabilityBinding"
      },
      {
        "kind": "Migration"
      },
      {
        "kind": "PolicyException"
      }
    ],
    "/scenarios": [
      {
        "name": "normal-create"
      },
      {
        "name": "duplicate-timeout"
      },
      {
        "name": "partial-provision"
      },
      {
        "name": "gitops-drift"
      },
      {
        "name": "tenant-exhaustion"
      },
      {
        "name": "credential-policy-failure"
      },
      {
        "name": "profile-upgrade"
      },
      {
        "name": "service-retirement"
      }
    ]
  },
  "pathComparisons": [
    {
      "left": "/product/problem",
      "op": "ne",
      "right": "/product/outcome"
    }
  ],
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/controlPlane/idempotency",
          "/controlPlane/failureIsolation",
          "/projectTransition/steps"
        ],
        "nonEmptyPaths": [
          "/controlPlane/idempotency",
          "/controlPlane/failureIsolation"
        ],
        "valueTypes": {
          "/projectTransition/steps": "array"
        }
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
