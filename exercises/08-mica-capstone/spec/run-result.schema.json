{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mica/run-result.schema.json",
  "title": "Mica Run Result",
  "type": "object",
  "required": ["schema_version", "command", "source", "stdout", "return_value", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "command": {"const": "run"},
    "source": {
      "type": "object",
      "required": ["id", "byte_length"],
      "properties": {
        "id": {"type": "string"},
        "byte_length": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "stdout": {"type": "string"},
    "return_value": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": {"enum": ["Int", "Bool", "String", "Unit"]},
            "value": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "diagnostics": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
