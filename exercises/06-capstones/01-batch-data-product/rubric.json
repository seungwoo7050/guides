{
  "version": 2,
  "capstone_id": "batch-data-product",
  "title": "Batch 데이터 제품 capstone",
  "required_artifacts": [
    "data-contract.md",
    "input-manifest.json",
    "pipeline-design.md",
    "failure-matrix.md",
    "quality-plan.json",
    "reconciliation.md",
    "runbook.md",
    "evidence.json",
    "submission.json"
  ],
  "required_scenarios": [
    "normal",
    "input-order-permutation",
    "duplicate-manifest-file",
    "duplicate-payment-event",
    "transform-crash",
    "quality-gate-failure",
    "pre-publish-commit-failure",
    "post-publish-retry",
    "concurrent-publish",
    "missing-reference-snapshot",
    "late-refund-boundary",
    "partial-or-mutable-input",
    "conflicting-payment-event",
    "backfill-live-contention",
    "semantic-canary-mismatch",
    "reconciliation-mismatch"
  ],
  "required_nonempty_json": {
    "input-manifest.json": ["sources", "schema_versions", "reference_versions"],
    "quality-plan.json": ["checks", "freshness", "publish_gate", "owners"]
  },
  "criteria": [
    "grain, stable key, event time, correction policy가 명시됨",
    "input manifest와 transform/reference/schema version이 고정됨",
    "동일 입력 replay가 같은 logical rows와 snapshot을 만듦",
    "staging, validation, publish pointer와 partial failure가 설명됨",
    "backfill canary, stop condition, resume, rollback이 있음",
    "count, key, aggregate reconciliation과 freshness/lineage가 있음"
  ],
  "reference_implementation": false
}
