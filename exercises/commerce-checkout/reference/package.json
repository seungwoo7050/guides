{
  "name": "commerce-checkout-reference",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test",
    "verify:01": "vitest run tests/01-money-order.test.ts",
    "verify:02": "vitest run tests/01-money-order.test.ts tests/02-checkout-inventory.test.ts",
    "verify:03": "vitest run tests/01-money-order.test.ts tests/02-checkout-inventory.test.ts tests/03-idempotent-payment.test.ts",
    "verify:04": "vitest run tests/01-money-order.test.ts tests/02-checkout-inventory.test.ts tests/03-idempotent-payment.test.ts tests/04-payment-webhook.test.ts",
    "verify:05": "vitest run tests/01-money-order.test.ts tests/02-checkout-inventory.test.ts tests/03-idempotent-payment.test.ts tests/04-payment-webhook.test.ts tests/05-cancel-refund.test.ts",
    "verify:06": "pnpm typecheck && vitest run"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "kysely": "^0.28.2",
    "pg": "^8.15.6",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.14",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "packageManager": "pnpm@10.32.1"
}
