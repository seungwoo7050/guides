From 891e082e7e2ebc49188b4d801c176a1bf53ed3b9 Mon Sep 17 00:00:00 2001
From: Seungwoo Kim <seungwoo7050@naver.com>
Date: Tue, 26 Aug 2025 19:12:00 +0900
Subject: [PATCH] feat(runtime): 실행 환경과 작업 공간 구성

diff --git a/apps/demo/src/index.ts b/apps/demo/src/index.ts
index 0b53b44..1e4135c 100644
--- a/apps/demo/src/index.ts
+++ b/apps/demo/src/index.ts
@@ -1,8 +1,10 @@
+// [Implementation 4] 소비자는 workspace package의 exports만 import해 내부 파일 배치와 분리됩니다.
 import { parsePort, sum } from "@exercise/math";

 console.log("sum", sum([1, 2, 3]));
 console.log("port", parsePort(process.env.PORT ?? "4000"));

+// [Implementation 5] 등록 순서와 실행 순서를 나란히 두어 sync, microtask, task의 lifecycle 차이를 관찰합니다.
 console.log("sync");
 queueMicrotask(() => console.log("microtask"));
 setTimeout(() => console.log("task"), 0);
diff --git a/packages/math/src/index.ts b/packages/math/src/index.ts
index b448488..e95a106 100644
--- a/packages/math/src/index.ts
+++ b/packages/math/src/index.ts
@@ -1,9 +1,13 @@
+// [Implementation 2] 공유 package의 첫 기능은 외부 상태가 없는 순수 연산으로 공개 경계를 확인합니다.
 export function sum(values: readonly number[]): number {
-  // TODO: 배열을 순회해 합계를 반환해 주세요.
-  throw new Error("TODO");
+  return values.reduce((total, value) => total + value, 0);
 }

+// [Implementation 3] 외부 입력을 unknown에서 시작해 유효한 TCP port invariant를 만족할 때만 number로 반환합니다.
 export function parsePort(input: unknown): number {
-  // TODO: 문자열이나 숫자를 1~65535 범위의 정수로 검증해 주세요.
-  throw new Error("TODO");
+  const value = typeof input === "string" ? Number(input) : input;
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 1 || value > 65535) {
+    throw new Error("포트는 1부터 65535 사이의 정수여야 합니다.");
+  }
+  return value;
 }
diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 286cf7f..b82fd12 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -1,3 +1,4 @@
+# [Implementation 1] app과 library package를 한 workspace로 묶되 공개 진입점은 각 package manifest가 소유합니다.
 packages:
   - apps/*
   - packages/*
--
