{
  "schemaVersion": 2,
  "title": "Platform journey SLO",
  "requiredPaths": [
    "/status",
    "/journeys",
    "/failureTaxonomy",
    "/correlation",
    "/alerts",
    "/errorBudgetActions",
    "/capacity",
    "/supportTiers",
    "/cost",
    "/communication"
  ],
  "nonEmptyPaths": [
    "/correlation/operationIdentity",
    "/capacity/headroomRule",
    "/capacity/admission",
    "/cost/showback",
    "/communication/userImpact"
  ],
  "minimumItems": {
    "/journeys": 2,
    "/failureTaxonomy": 5,
    "/alerts": 2,
    "/supportTiers": 3
  },
  "arrayItemRequiredFields": {
    "/journeys": [
      "name",
      "start",
      "success",
      "sli",
      "target",
      "owner"
    ],
    "/failureTaxonomy": [
      "class",
      "sloFailure",
      "owner",
      "action"
    ],
    "/alerts": [
      "name",
      "condition",
      "action",
      "runbook"
    ],
    "/supportTiers": [
      "name",
      "scope",
      "hours",
      "escalation"
    ]
  },
  "arrayUniqueBy": {
    "/journeys": "name",
    "/failureTaxonomy": "class",
    "/alerts": "name",
    "/supportTiers": "name"
  },
  "containsValues": {},
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {},
  "valueTypes": {
    "/status": "string",
    "/journeys": "array",
    "/failureTaxonomy": "array",
    "/failureTaxonomy/*/sloFailure": "boolean",
    "/correlation": "object",
    "/alerts": "array",
    "/errorBudgetActions": "object",
    "/capacity": "object",
    "/supportTiers": "array",
    "/cost": "object",
    "/communication": "object"
  },
  "arrayContainsObjects": {
    "/journeys": [
      {
        "name": "preview-environment-ready"
      },
      {
        "name": "production-release-observed"
      }
    ],
    "/failureTaxonomy": [
      {
        "class": "platform-defect",
        "sloFailure": true
      },
      {
        "class": "invalid-input",
        "sloFailure": false
      },
      {
        "class": "policy-deny",
        "sloFailure": false
      }
    ]
  },
  "conditionalRequirements": [
    {
      "if": {
        "path": "/status",
        "equals": "complete"
      },
      "then": {
        "requiredPaths": [
          "/errorBudgetActions/healthy",
          "/errorBudgetActions/fastBurn",
          "/errorBudgetActions/exhausted"
        ],
        "nonEmptyPaths": [
          "/errorBudgetActions/healthy",
          "/errorBudgetActions/fastBurn",
          "/errorBudgetActions/exhausted"
        ]
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
