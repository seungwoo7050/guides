{
  "schemaVersion": 2,
  "title": "Kubernetes workload contract",
  "requiredPaths": [
    "/status",
    "/workload",
    "/health",
    "/resources",
    "/network",
    "/storage",
    "/scheduling",
    "/disruption",
    "/conditions",
    "/ownership"
  ],
  "nonEmptyPaths": [
    "/workload/name",
    "/workload/kind",
    "/workload/profile",
    "/workload/owner",
    "/health/readyMeaning",
    "/resources/requestRationale",
    "/network/defaultPolicy",
    "/disruption/recoveryEvidence"
  ],
  "minimumItems": {
    "/conditions": 4,
    "/ownership": 5,
    "/network/allowedFlows": 3,
    "/disruption/scenarios": 3
  },
  "arrayItemRequiredFields": {
    "/conditions": [
      "type",
      "signal",
      "owner",
      "action"
    ],
    "/ownership": [
      "boundary",
      "applicationTeam",
      "platformTeam"
    ],
    "/network/allowedFlows": [
      "direction",
      "peer",
      "purpose"
    ],
    "/disruption/scenarios": [
      "event",
      "expectedBehavior",
      "evidence"
    ]
  },
  "arrayUniqueBy": {
    "/conditions": "type",
    "/ownership": "boundary"
  },
  "containsValues": {},
  "allowedValues": {
    "/status": [
      "complete"
    ]
  },
  "matches": {
    "/health/readyMeaning": "(?is).*(accept|request|traffic).*"
  },
  "valueTypes": {
    "/status": "string",
    "/workload": "object",
    "/workload/replicas": "integer",
    "/health": "object",
    "/resources": "object",
    "/network": "object",
    "/storage": "object",
    "/scheduling": "object",
    "/disruption": "object",
    "/disruption/maxUnavailable": "integer",
    "/conditions": "array",
    "/ownership": "array"
  },
  "arrayContainsObjects": {
    "/network/allowedFlows": [
      {
        "direction": "ingress"
      },
      {
        "direction": "egress"
      }
    ],
    "/disruption/scenarios": [
      {
        "event": "single Pod deletion"
      },
      {
        "event": "node drain"
      },
      {
        "event": "zone loss"
      }
    ]
  },
  "conditionalRequirements": [
    {
      "if": {
        "path": "/workload/kind",
        "equals": "Deployment"
      },
      "then": {
        "requiredPaths": [
          "/workload/replicas",
          "/disruption/maxUnavailable"
        ],
        "nonEmptyPaths": [
          "/disruption/recoveryEvidence"
        ],
        "valueTypes": {
          "/workload/replicas": "integer",
          "/disruption/maxUnavailable": "integer"
        }
      }
    }
  ],
  "forbiddenSubstrings": [
    "TODO",
    "TBD",
    "작성하세요",
    "미정",
    "placeholder"
  ]
}
