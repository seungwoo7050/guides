{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guides.invalid/distributed-systems/capstone-run-report.schema.json",
  "title": "Distributed systems capstone run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest", "runs", "counterexample"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest": {"type": "string", "minLength": 1},
    "runs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/run"}
    },
    "counterexample": {"$ref": "#/$defs/counterexample"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_bundle_id",
        "source_tree_sha256",
        "configuration_sha256",
        "initial_state_sha256",
        "seed",
        "schedule_sha256"
      ],
      "properties": {
        "run_bundle_id": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "initial_state_sha256": {"$ref": "#/$defs/sha256"},
        "seed": {"type": "integer"},
        "schedule_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "observed_trace_digest"],
      "properties": {
        "command": {"$ref": "#/$defs/string_array"},
        "exit_code": {"const": 0},
        "observed_trace_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "invariant_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "checked_steps", "invariant_ids"],
      "properties": {
        "result": {"const": "PASS"},
        "checked_steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 1}
        },
        "invariant_ids": {"$ref": "#/$defs/string_array"}
      }
    },
    "history_evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "witness", "pending_policy"],
          "properties": {
            "result": {"const": "PASS"},
            "witness": {"$ref": "#/$defs/string_array"},
            "pending_policy": {"enum": ["drop", "complete", "either"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "reason"],
          "properties": {
            "result": {"const": "UNVERIFIED"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "run_id",
        "identity",
        "trace",
        "trace_digest",
        "replay",
        "invariant_evidence",
        "history_evidence"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "identity": {"$ref": "#/$defs/identity"},
        "trace": {"type": "string", "minLength": 1},
        "trace_digest": {"$ref": "#/$defs/sha256"},
        "replay": {"$ref": "#/$defs/replay"},
        "invariant_evidence": {"$ref": "#/$defs/invariant_evidence"},
        "history_evidence": {"$ref": "#/$defs/history_evidence"}
      }
    },
    "counterexample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace",
        "trace_digest",
        "diagnostic_id",
        "original_steps",
        "minimized_steps",
        "replay_command"
      ],
      "properties": {
        "trace": {"type": "string", "minLength": 1},
        "trace_digest": {"$ref": "#/$defs/sha256"},
        "diagnostic_id": {"type": "string", "minLength": 1},
        "original_steps": {"type": "integer", "minimum": 2},
        "minimized_steps": {"type": "integer", "minimum": 1},
        "replay_command": {"$ref": "#/$defs/string_array"}
      }
    }
  }
}
