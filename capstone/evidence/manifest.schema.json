{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guides.invalid/distributed-systems/capstone-manifest.schema.json",
  "title": "Distributed systems capstone run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_bundle_id",
    "source",
    "runtime",
    "configuration_sha256",
    "initial_state_sha256",
    "schedule_bundle_sha256",
    "seed",
    "supported_failure_model"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_bundle_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree_sha256", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "dirty": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "platform"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "initial_state_sha256": {"$ref": "#/$defs/sha256"},
    "schedule_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "seed": {"type": "integer"},
    "supported_failure_model": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
