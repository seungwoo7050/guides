{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/schemas/service-environment-v1alpha1.json",
  "title": "ServiceEnvironment",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "platform.northstar.dev/v1alpha1"
    },
    "kind": {
      "const": "ServiceEnvironment"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "owner"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "owner": {
          "type": "string",
          "pattern": "^team-[a-z0-9-]+$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["service", "environmentClass", "releaseDigest", "runtimeProfile", "exposure"],
      "properties": {
        "service": {"type": "string", "minLength": 1},
        "environmentClass": {
          "enum": ["preview", "staging", "production"]
        },
        "releaseDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtimeProfile": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "dataProfile": {
          "type": ["string", "null"]
        },
        "exposure": {
          "enum": ["none", "internal", "public"]
        },
        "deletionPolicy": {
          "enum": ["Delete", "RetainData", "Archive", "Block"],
          "default": "Delete"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
